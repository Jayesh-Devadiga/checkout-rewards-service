# Copy this file to .env and change what you need.
#
# Every line is optional. The values below are the defaults the service uses
# when a variable is not set, and they match docker-compose.yml.
# A variable set in the real environment wins over this file.

# Port the service listens on
PORT=3000

# PostgreSQL connection for the service
DATABASE_URL=postgres://checkout:checkout@localhost:5433/checkout

# n: a coupon becomes available at every nth placed order.
# Whole number, 1 or more.
COUPON_EVERY_N_ORDERS=5

# x: percent off for each generated coupon.
# Whole number, 1 to 100.
COUPON_DISCOUNT_PERCENT=10

# Database used by "npm test". It is dropped and recreated on every test run,
# so its name must end in _test.
TEST_DATABASE_URL=postgres://checkout:checkout@localhost:5433/checkout_test
